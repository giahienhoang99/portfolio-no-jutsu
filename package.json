{
  "name": "portfolio-no-jutsu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @portfolio-no-jutsu/web",
    "dev:analytics": "npm run dev --workspace @portfolio-no-jutsu/analytics-dashboard",
    "build": "npm run build --workspace @portfolio-no-jutsu/web",
    "build:analytics": "npm run build --workspace @portfolio-no-jutsu/analytics-dashboard",
    "build:all": "npm run build && npm run build:analytics",
    "lint": "npm run lint --workspace @portfolio-no-jutsu/web && npm run lint --workspace @portfolio-no-jutsu/analytics-dashboard",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analytics:migrate": "tsx apps/web/src/lib/analytics/migrate.ts",
    "analytics:migrate:check": "tsx apps/web/src/lib/analytics/migrate.ts --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
